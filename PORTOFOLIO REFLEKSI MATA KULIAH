    <!-- INTERACTIVE JAVASCRIPT -->
    <script>
        function switchTab(tabId) {
            // Hide all course cards
            const cards = document.querySelectorAll('.course-card');
            cards.forEach(card => card.classList.add('hidden'));

            // Show target card
            const targetCard = document.getElementById(tabId);
            if(targetCard) {
                targetCard.classList.remove('hidden');
            }

            // Update tab button styles
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white', 'border-brand-600', 'shadow-sm');
                btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
            });

            const activeBtn = document.getElementById('btn-' + tabId);
            if(activeBtn) {
                activeBtn.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
                activeBtn.classList.add('bg-brand-600', 'text-white', 'border-brand-600', 'shadow-sm');
            }
        }

        function filterCourses() {
            const query = document.getElementById('courseSearch').value.toLowerCase();
            const cards = document.querySelectorAll('.course-card');
            
            if(query.trim() === '') {
                // Return to active tab
                switchTab('mk1');
                return;
            }

            cards.forEach(card => {
                const text = card.textContent.toLowerCase();
                if(text.includes(query)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }
    </script>
